# Copy to .env in this folder. Keep .env local and never commit real keys.
APIFY_API_TOKEN=add-your-apify-token-locally
EXA_API_KEY=add-your-exa-key-locally
GEMINI_API_KEY=add-your-gemini-key-locally
SENTIMENT_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash

# Optional Actor ID overrides (defaults are documented in config/tickers.yaml).
APIFY_LIHKG_ACTOR_ID=claude_code_reviewer/lihkg-scraper-en
APIFY_TELEGRAM_ACTOR_ID=innolabs/telegram-scraper
